{
  "name": "@genopsys/openclaw-mail-router",
  "version": "0.3.0-experimental.1",
  "type": "module",
  "description": "Independent IMAP collector and OpenClaw public webhook router",
  "engines": {
    "node": ">=22.19.0"
  },
  "openclaw": {
    "extensions": [
      "./src/index.mjs"
    ]
  },
  "files": [
    "src/",
    "openclaw.plugin.json",
    "README.md",
    "scripts/",
    "examples/"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "prepack": "npm run check && npm test"
  },
  "dependencies": {
    "imapflow": "2.11.0",
    "mailparser": "3.14.3"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genopsys-io/openclaw-mail-router.git"
  },
  "homepage": "https://github.com/Genopsys-io/openclaw-mail-router#readme",
  "bugs": {
    "url": "https://github.com/Genopsys-io/openclaw-mail-router/issues"
  },
  "license": "UNLICENSED"
}
