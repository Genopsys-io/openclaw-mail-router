# Inject into the GATEWAY process (Docker env_file / Kubernetes Secret).
# This file is an example, not automatically loaded by the plugin.
MAIL_ROUTER_HOST=imap.example.org
MAIL_ROUTER_USER=assistant@example.org
MAIL_ROUTER_PASSWORD=CHANGE_ME
MAIL_ROUTER_FALLBACK_AGENT_ID=mail-reader
MAIL_ROUTER_ALLOWED_SENDERS=operator@example.org
MAIL_ROUTER_TRUSTED_AUTHSERV_IDS=mx.example.org
# Explicit opt-in: the receiver must sanitize forged Authentication-Results.
MAIL_ROUTER_TRUST_RECEIVER=true

# One client route; replace the group with an authorized real group.
MAIL_ROUTER_RECIPIENT=assistant+client-a@example.org
MAIL_ROUTER_AGENT_ID=client-a
MAIL_ROUTER_WHATSAPP_GROUP=111111111@g.us

# Only new mail on first start; omit to require a pre-imported cursor.
MAIL_ROUTER_START_FROM=now

# Optional defaults (do not change ACCOUNT_ID during a migration).
MAIL_ROUTER_ACCOUNT_ID=shared
MAIL_ROUTER_ROUTE_ID=default
MAIL_ROUTER_RECIPIENT_NAMESPACE=assistant@example.org
MAIL_ROUTER_PORT=993
MAIL_ROUTER_MAILBOX=INBOX
MAIL_ROUTER_CHANNEL_ACCOUNT_ID=default
MAIL_ROUTER_POLL_SECONDS=60
MAIL_ROUTER_MAX_BYTES=20000

# Separate Gateway hook configuration is still required.
# MAIL_ROUTER_HOOK_TOKEN=<dedicated-random-value>
